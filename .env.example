# ============================================================
# نمونه تنظیمات محیطی — مقادیر واقعی را در فایل .env قرار دهید
# این فایل فقط نام متغیرها و مقدار نمونه غیرمحرمانه دارد (بخش ۲۲.۲ سند)
# ============================================================

# --- تلگرام ---
# توکن ربات تلگرام (از @BotFather)
TELEGRAM_BOT_TOKEN=123456789:PUT-YOUR-REAL-TOKEN-HERE
# نام کاربری ربات بدون @ (فقط برای نمایش)
TELEGRAM_BOT_USERNAME=my_ig_downloader_bot
# اختیاری: آدرس Telegram Local Bot API Server برای فایل‌های تا ۲ گیگابایت
# اگر خالی بماند، از Bot API رسمی (سقف آپلود بات ۵۰ مگابایت) استفاده می‌شود.
# TELEGRAM_BASE_URL=http://telegram-bot-api:8081/bot
# در صورت استفاده از Local Bot API باید دو مقدار زیر نیز تنظیم شوند:
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# --- اینستاگرام (اکانت مخصوص ربات) ---
INSTAGRAM_USERNAME=your_bot_instagram_account
INSTAGRAM_PASSWORD=your_bot_instagram_password
# اختیاری: کد تأیید دومرحله‌ای ثابت (اگر 2FA فعال است)
INSTAGRAM_2FA_CODE=

# --- مدیران اولیه (شناسه عددی تلگرام، با کاما جدا کنید) ---
# اولین مدیر با نقش «مدیر اصلی» ساخته می‌شود
ADMIN_IDS=123456789,987654321

# --- پروکسی (اختیاری) ---
# مثال: http://127.0.0.1:3067  یا socks5://127.0.0.1:1080
# اگر خالی باشد اتصال مستقیم انجام می‌شود
PROXY=

# --- مسیرها ---
DATABASE_PATH=storage/bot.db
STORAGE_DIR=storage
LOG_LEVEL=INFO

# --- دریافت دایرکت اینستاگرام (پایش) ---
# فاصله چک‌کردن دایرکت بر حسب ثانیه (کمینه و بیشینه، تصادفی بین آن دو)
IG_POLL_MIN=30
IG_POLL_MAX=60
# پول سریع: پس از اینکه کاربر «اتصال اینستاگرام» را می‌زند، برای این
# تعداد ثانیه صندوق با فاصلهٔ کمتر چک می‌شود تا کد اتصال سریع برسد.
IG_FAST_POLL_MIN=6
IG_FAST_POLL_MAX=9
IG_FAST_WINDOW=600
